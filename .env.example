# Local credentials. Keep the populated .env outside Git.
NBIM_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_INPUT_USD_PER_MTOK=
ANTHROPIC_OUTPUT_USD_PER_MTOK=

